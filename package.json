{
  "name": "parkside-price-watch",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate:data": "pnpm --filter core validate",
    "validate:output": "pnpm --filter core validate:output",
    "fx:update": "pnpm --filter crawler fx:update",
    "crawl": "pnpm --filter crawler start"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
